{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/usr/share/yuna/logo.txt",
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": "  ~  ",
    "key": { "width": 12 }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "localip",
    "wifi",
    "break",
    "colors"
  ]
}
